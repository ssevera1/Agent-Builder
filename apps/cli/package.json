{
  "name": "@agentbuilder/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "agentbuilder": "./dist/bin/agentbuilder.js",
    "ab": "./dist/bin/agentbuilder.js"
  },
  "scripts": {
    "build": "tsup src/index.ts src/bin/agentbuilder.ts --format esm --dts --clean",
    "dev": "tsup src/bin/agentbuilder.ts --format esm --watch --onSuccess 'node dist/bin/agentbuilder.js'",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@agentbuilder/core": "workspace:*",
    "@agentbuilder/llm": "workspace:*",
    "@agentbuilder/engine": "workspace:*",
    "@agentbuilder/tools": "workspace:*",
    "@agentbuilder/memory": "workspace:*",
    "@agentbuilder/workflow": "workspace:*",
    "@agentbuilder/evaluation": "workspace:*",
    "@agentbuilder/storage": "workspace:*",
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
