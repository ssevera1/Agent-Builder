# AgentBuilder Environment Configuration
# Copy this file to .env and fill in your values

# === LLM Provider API Keys ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHER_API_KEY=
GROQ_API_KEY=
FIREWORKS_API_KEY=

# === Local Model Endpoints ===
OLLAMA_BASE_URL=http://localhost:11434
LM_STUDIO_BASE_URL=http://localhost:1234/v1
VLLM_BASE_URL=http://localhost:8000/v1

# === Default Provider ===
AGENTBUILDER_DEFAULT_PROVIDER=anthropic
AGENTBUILDER_DEFAULT_MODEL=claude-sonnet-4-20250514

# === Storage ===
AGENTBUILDER_DATA_DIR=
AGENTBUILDER_LOG_LEVEL=info

# === Web UI ===
AGENTBUILDER_PORT=3777
AGENTBUILDER_HOST=localhost
