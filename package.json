{
  "name": "agentbuilder",
  "version": "0.1.0",
  "private": true,
  "description": "A comprehensive, cross-platform AI agent builder with multi-provider support, automated workflows, and extensible tool system",
  "license": "MIT",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "typecheck": "turbo run typecheck"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  },
  "devDependencies": {
    "turbo": "^2.8.14"
  }
}
